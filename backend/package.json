{
  "name": "@itsu-sushi/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/bootstrap/app.js",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register src/bootstrap/app.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "start": "cross-env TS_NODE_PROJECT=tsconfig.runtime.json node -r tsconfig-paths/register dist/bootstrap/app.js",
    "seed:admin": "ts-node -r tsconfig-paths/register src/scripts/seed-admin.ts",
    "migrate:seat-holds": "ts-node -r tsconfig-paths/register src/scripts/migrations/migrate-seat-holds.ts",
    "migrate:reservations": "ts-node -r tsconfig-paths/register src/scripts/migrations/migrate-reservations.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.4",
    "multer": "^2.1.1",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "cross-env": "^7.0.3",
    "vitest": "^3.2.4"
  }
}
